{
	"type": "module",
	"name": "@f5-sales-demo/xcsh-chat-ui",
	"version": "0.1.0",
	"private": true,
	"description": "Shared F5 xcsh-terminal chat UI: design tokens + React components, consumed by the Office add-in (workspace) and vendored into the VS Code + Chrome extensions",
	"homepage": "https://github.com/f5-sales-demo/xcsh",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/f5-sales-demo/xcsh.git",
		"directory": "packages/chat-ui"
	},
	"bugs": {
		"url": "https://github.com/f5-sales-demo/xcsh/issues"
	},
	"keywords": [
		"xcsh",
		"chat",
		"ui",
		"f5",
		"terminal",
		"react"
	],
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"gen-tokens": "bun scripts/gen-tokens.ts",
		"gen-temml-css": "bun scripts/generate-temml-css.ts",
		"gen-md-goldens": "bun scripts/gen-md-goldens.ts",
		"sync-vendor": "bun scripts/sync-vendor.ts",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit && tsgo -p tsconfig.client.json --noEmit",
		"test": "bun test --preload ./test/register-dom.ts --preload ./test/setup.ts ./test/*.test.ts ./test/*.test.tsx && bun run test:markdown",
		"test:markdown": "bun test --preload ./test/markdown/register-jsdom.ts --preload ./test/setup.ts ./test/markdown",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"dompurify": "3.4.14",
		"marked": "18.0.11",
		"temml": "0.13.5"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "20.13.2",
		"@testing-library/react": "16.3.3",
		"@types/bun": "1.4.2",
		"@types/jsdom": "30.0.0",
		"jsdom": "30.0.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"engines": {
		"bun": ">=1.4.2"
	},
	"files": [
		"src"
	]
}
