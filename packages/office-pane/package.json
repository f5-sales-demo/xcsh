{
	"type": "module",
	"name": "@f5-sales-demo/xcsh-office-pane",
	"version": "0.1.0",
	"private": true,
	"description": "Browser task-pane UI + bridge transport + Office.js host tools for the xcsh agent",
	"homepage": "https://github.com/f5-sales-demo/xcsh",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/f5-sales-demo/xcsh.git",
		"directory": "packages/office-pane"
	},
	"bugs": {
		"url": "https://github.com/f5-sales-demo/xcsh/issues"
	},
	"keywords": [
		"office",
		"add-in",
		"taskpane",
		"xcsh",
		"react"
	],
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"build": "bun run build.ts",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit && tsgo -p tsconfig.client.json --noEmit",
		"test": "bun test --preload ./test/register-dom.ts --preload ./test/setup.ts",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write .",
		"uat:plugin-surface": "bun scripts/uat-plugin-surface.ts",
		"uat:meddpicc-excel": "bun scripts/uat-meddpicc-excel.ts"
	},
	"dependencies": {
		"@f5-sales-demo/pi-agent-core": "workspace:*",
		"@f5-sales-demo/xcsh": "workspace:*",
		"@f5-sales-demo/xcsh-chat-ui": "workspace:*",
		"react": "^19.2",
		"react-dom": "^19.2"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.10.6",
		"@testing-library/react": "^16.0.0",
		"@types/bun": "^1.3",
		"@types/office-js": "^1.0.0",
		"@types/react": "^19.2",
		"@types/react-dom": "^19.2",
		"ajv": "^8.17.1",
		"office-addin-mock": "^3.0",
		"puppeteer": "^25.3"
	},
	"engines": {
		"bun": ">=1.3.7"
	},
	"files": [
		"src",
		"build.ts"
	]
}
