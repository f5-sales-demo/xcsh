{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "missing", "reason"],
  "properties": {
    "status": {"type": "string", "enum": ["ready", "incomplete", "hold"]},
    "missing": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string"}
  }
}
