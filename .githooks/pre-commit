#!/bin/sh
# Pre-commit hook: checks staged files with Biome and runs the full TypeScript
# gate used by CI. It also blocks staged F5 XC context files (credentials).
# Installed automatically via `bun install` (prepare script sets core.hooksPath).
# To bypass in emergencies: git commit --no-verify

# Block F5 XC context files from being committed
BLOCKED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.xcsh/contexts/' || true)
if [ -n "$BLOCKED_FILES" ]; then
  echo "ERROR: Refusing to commit F5 XC context files." >&2
  echo "These files may contain API tokens and must not be checked in." >&2
  echo "" >&2
  echo "Files blocked:" >&2
  echo "$BLOCKED_FILES" | sed 's/^/  /' >&2
  echo "" >&2
  echo "If these files are in your staging area by mistake, run:" >&2
  echo "  git reset HEAD -- .xcsh/contexts/" >&2
  exit 1
fi

DOCS_QUALITY_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(docs/en/|docs/llms-config\.json|\.github/docs-quality/|scripts/check_docs_quality\.py|tests/test_docs_quality\.py)' || true)
if [ -n "$DOCS_QUALITY_FILES" ] && [ "${XCSH_DOCS_QUALITY_CHECK:-1}" != "0" ]; then
  python3 scripts/check_docs_quality.py || exit 1
  python3 -m unittest tests.test_docs_quality || exit 1
elif [ -n "$DOCS_QUALITY_FILES" ]; then
  echo "WARNING: documentation quality check skipped by XCSH_DOCS_QUALITY_CHECK=0" >&2
fi

# Full-workspace checks must see only the staged snapshot. lint-staged may
# temporarily hide unstaged edits, but check:ts would otherwise inspect them.
UNSTAGED_FILES=$(git diff --name-only --) || exit 1
UNTRACKED_FILES=$(git ls-files --others --exclude-standard) || exit 1
if [ -n "$UNSTAGED_FILES" ] || [ -n "$UNTRACKED_FILES" ]; then
  echo "ERROR: Commit requires a clean non-ignored working tree outside staged changes." >&2
  echo "Stage, stash, or remove unstaged and untracked files before retrying." >&2
  exit 1
fi

EXPECTED_BUN=$(sed -n 's/.*"packageManager": "bun@\([^"]*\)".*/\1/p' package.json)
if [ -z "$EXPECTED_BUN" ]; then
  echo "ERROR: Cannot read the Bun version from package.json packageManager." >&2
  exit 1
fi
if ! command -v bun >/dev/null 2>&1; then
  echo "ERROR: Bun $EXPECTED_BUN is required; install it before committing." >&2
  exit 1
fi
ACTUAL_BUN=$(bun --version) || exit 1
if [ "$ACTUAL_BUN" != "$EXPECTED_BUN" ]; then
  echo "ERROR: Bun $EXPECTED_BUN is required by packageManager; found $ACTUAL_BUN." >&2
  exit 1
fi

if ! bun run check:dependencies; then
  echo "ERROR: Dependencies must match bun.lock. Run bun install --frozen-lockfile, then retry." >&2
  exit 1
fi

./node_modules/.bin/lint-staged || exit 1
bun run check:ts
