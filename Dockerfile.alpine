# syntax=docker/dockerfile:1.12

ARG ALPINE_IMAGE=alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
ARG BUILDER_IMAGE=debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171

FROM ${ALPINE_IMAGE} AS tools

SHELL ["/bin/ash", "-eo", "pipefail", "-c"]

ARG TARGETARCH
ARG BUN_VERSION=1.4.2
ARG BUN_AMD64_SHA256=c678040f14fe0440eb839d37cbd0ce4c051a32da72806ac97de6a6aab6bf728f
ARG BUN_ARM64_SHA256=54328bbc2d9c8e0c9f892c544d66c57a83b84139e34909e5ee81758f1ac8fda7
ARG GCLOUD_VERSION=583.0.0
ARG GCLOUD_AMD64_SHA256=84c5e4798836bda13aa82c3e84fa1acd0c4e4ca5318f7141052e3a5a26a7cc97
ARG GCLOUD_ARM64_SHA256=8ce6287e01e54b53d2e9618d124b62ac85efe5a093904ae027b17f2057030662
ARG ZIG_VERSION=0.15.2
ARG ZIG_AMD64_SHA256=02aa270f183da276e5b5920b1dac44a63f1a49e55050ebde3aecc9eb82f93239
ARG ZIG_ARM64_SHA256=958ed7d1e00d0ea76590d27666efbf7a932281b3d7ba0c6b01b0ff26498f667f

# hadolint ignore=DL3018
RUN apk add --no-cache ca-certificates curl tar unzip xz

WORKDIR /tmp/downloads

RUN case "${TARGETARCH}" in \
      amd64) bun_arch=x64-baseline; bun_sha256="${BUN_AMD64_SHA256}" ;; \
      arm64) bun_arch=aarch64; bun_sha256="${BUN_ARM64_SHA256}" ;; \
      *) echo "Unsupported TARGETARCH for Bun: ${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    curl --fail --silent --show-error --location \
      --output bun.zip \
      "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-${bun_arch}.zip" && \
    echo "${bun_sha256}  bun.zip" | sha256sum -c - && \
    unzip -q bun.zip && \
    install -D -m 0755 "bun-linux-${bun_arch}/bun" /opt/bun/bin/bun

RUN case "${TARGETARCH}" in \
      amd64) gcloud_arch=x86_64; gcloud_sha256="${GCLOUD_AMD64_SHA256}" ;; \
      arm64) gcloud_arch=arm; gcloud_sha256="${GCLOUD_ARM64_SHA256}" ;; \
      *) echo "Unsupported TARGETARCH for Google Cloud CLI: ${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    curl --fail --silent --show-error --location \
      --output gcloud.tar.gz \
      "https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-${GCLOUD_VERSION}-linux-${gcloud_arch}.tar.gz" && \
    echo "${gcloud_sha256}  gcloud.tar.gz" | sha256sum -c - && \
    mkdir -p /opt && \
    tar -xzf gcloud.tar.gz -C /opt

RUN case "${TARGETARCH}" in \
      amd64) zig_arch=x86_64; zig_sha256="${ZIG_AMD64_SHA256}" ;; \
      arm64) zig_arch=aarch64; zig_sha256="${ZIG_ARM64_SHA256}" ;; \
      *) echo "Unsupported TARGETARCH for Zig: ${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    curl --fail --silent --show-error --location \
      --output zig.tar.xz \
      "https://ziglang.org/download/${ZIG_VERSION}/zig-${zig_arch}-linux-${ZIG_VERSION}.tar.xz" && \
    echo "${zig_sha256}  zig.tar.xz" | sha256sum -c - && \
    mkdir -p /opt/zig && \
    tar -xJf zig.tar.xz --strip-components=1 -C /opt/zig

FROM ${BUILDER_IMAGE} AS builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG TARGETARCH
ARG RUST_TOOLCHAIN=nightly-2026-09-03
ARG RUSTUP_INIT_AMD64_SHA256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
ARG RUSTUP_INIT_ARM64_SHA256=15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433

# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git libstdc++6 python3 && \
    rm -rf /var/lib/apt/lists/* && \
    case "${TARGETARCH}" in \
      amd64) rust_host=x86_64-unknown-linux-gnu; rustup_sha256="${RUSTUP_INIT_AMD64_SHA256}" ;; \
      arm64) rust_host=aarch64-unknown-linux-gnu; rustup_sha256="${RUSTUP_INIT_ARM64_SHA256}" ;; \
      *) echo "Unsupported TARGETARCH for Rust: ${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    curl --fail --silent --show-error --location \
      --output /tmp/rustup-init \
      "https://static.rust-lang.org/rustup/dist/${rust_host}/rustup-init" && \
    echo "${rustup_sha256}  /tmp/rustup-init" | sha256sum -c - && \
    chmod 0755 /tmp/rustup-init && \
    /tmp/rustup-init -y \
      --profile minimal \
      --default-host "${rust_host}" \
      --default-toolchain "${RUST_TOOLCHAIN}" && \
    rm /tmp/rustup-init

COPY --from=tools /opt/bun /opt/bun
COPY --from=tools /opt/zig /opt/zig

ENV CARGO_HOME=/root/.cargo \
    RUSTUP_HOME=/root/.rustup \
    RUSTUP_TOOLCHAIN=nightly-2026-09-03 \
    PATH="/root/.cargo/bin:/opt/bun/bin:/opt/zig:${PATH}"
WORKDIR /src
COPY . .

ARG XCSH_BUILD_COMMIT=""
ARG XCSH_BUILD_BRANCH=""
ARG XCSH_BUILD_TAG=""
ENV XCSH_BUILD_COMMIT=${XCSH_BUILD_COMMIT} \
    XCSH_BUILD_BRANCH=${XCSH_BUILD_BRANCH} \
    XCSH_BUILD_TAG=${XCSH_BUILD_TAG}

RUN bun install --frozen-lockfile --ignore-scripts && \
    bun --cwd=packages/coding-agent run generate-docs-index && \
    case "${TARGETARCH}" in \
      amd64) export TARGET_VARIANT=baseline ;; \
      arm64) export RUSTFLAGS="-C target-cpu=generic" ;; \
      *) echo "Unsupported TARGETARCH for native build: ${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    bun --cwd=packages/natives run build

RUN bun --cwd=packages/coding-agent run build && \
    test -x packages/coding-agent/dist/xcsh

# Preserve the target architecture's glibc interpreter paths while exposing a
# single architecture-neutral copy source to the runtime stage.
RUN case "${TARGETARCH}" in \
      amd64) \
        gnu_triplet=x86_64-linux-gnu; \
        loader=ld-linux-x86-64.so.2; \
        loader_destination=/lib64/ld-linux-x86-64.so.2 \
        ;; \
      arm64) \
        gnu_triplet=aarch64-linux-gnu; \
        loader=ld-linux-aarch64.so.1; \
        loader_destination=/lib/ld-linux-aarch64.so.1 \
        ;; \
      *) echo "Unsupported TARGETARCH for glibc staging: ${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    install -D -m 0755 \
      "/lib/${gnu_triplet}/${loader}" \
      "/opt/glibc-root${loader_destination}" && \
    for library in libc.so.6 libdl.so.2 libm.so.6 libpthread.so.0 libgcc_s.so.1; do \
      install -D -m 0755 \
        "/lib/${gnu_triplet}/${library}" \
        "/opt/glibc-root/lib/${gnu_triplet}/${library}"; \
    done

FROM ${ALPINE_IMAGE} AS runtime

ARG USER_NAME=xcsh
ARG USER_UID=1000
ARG USER_GID=1000
ARG AZURE_CLI_VERSION=2.90.0
ARG AWS_CLI_VERSION=1.46.1
ARG SALESFORCE_CLI_VERSION=2.151.6

SHELL ["/bin/ash", "-eo", "pipefail", "-c"]

# hadolint ignore=DL3018
RUN apk add --no-cache \
      bash \
      ca-certificates \
      coreutils-env \
      curl \
      git \
      github-cli \
      jq \
      libstdc++ \
      nodejs \
      npm \
      py3-pip \
      python3 && \
    python3 -m venv /opt/cloud-cli && \
    /opt/cloud-cli/bin/pip install --no-cache-dir \
      "awscli==${AWS_CLI_VERSION}" \
      "azure-cli==${AZURE_CLI_VERSION}" && \
    npm install --global "@salesforce/cli@${SALESFORCE_CLI_VERSION}" && \
    npm cache clean --force && \
    addgroup -g "${USER_GID}" "${USER_NAME}" && \
    adduser -D -u "${USER_UID}" -G "${USER_NAME}" \
      -h "/home/${USER_NAME}" -s /bin/bash "${USER_NAME}" && \
    install -d -o "${USER_UID}" -g "${USER_GID}" \
      "/home/${USER_NAME}/.azure-host" \
      "/home/${USER_NAME}/.aws-host" \
      "/home/${USER_NAME}/.config/gcloud-host" \
      "/home/${USER_NAME}/.config/gh-host" \
      "/home/${USER_NAME}/.sfdx-host"

# Bun and the embedded N-API addon use glibc. Keep their pinned loader and
# shared libraries isolated from Alpine's musl search paths.
COPY --from=builder /opt/glibc-root/ /

COPY --from=tools /opt/bun /opt/bun
COPY --from=tools /opt/google-cloud-sdk /opt/google-cloud-sdk
COPY --from=tools /opt/zig /opt/zig
COPY --from=builder /src/packages/coding-agent/dist/xcsh /usr/local/bin/xcsh

ENV CLOUDSDK_PYTHON=/usr/bin/python3 \
    HOME=/home/xcsh \
    PATH="/opt/cloud-cli/bin:/opt/google-cloud-sdk/bin:/opt/bun/bin:/opt/zig:${PATH}"

WORKDIR /workspace
USER ${USER_NAME}

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD ["xcsh", "--version"]

ENTRYPOINT ["xcsh"]
